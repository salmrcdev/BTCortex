{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BTCortex",
  "version": "0.1.0",
  "identifier": "com.btcortex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "BTCortex",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "resizable": true,
        "backgroundColor": "#0F172A",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/btcortex-orchestrator"],
    "resources": {
      "resources/openpgp/openpgp.cjs": "openpgp/openpgp.cjs",
      "resources/openpgp/LICENSE": "openpgp/LICENSE",
      "resources/openpgp/NOTICE.txt": "openpgp/NOTICE.txt",
      "resources/THIRD_PARTY_LICENCES.txt": "THIRD_PARTY_LICENCES.txt"
    },
    "publisher": "BTCortex",
    "category": "Finance",
    "shortDescription": "Bitcoin ecosystem command centre",
    "longDescription": "BTCortex installs, configures, connects and monitors the self-hosted Bitcoin ecosystem — nodes, Electrum servers, wallets, Lightning, Tor and more — from one Windows application.",
    "copyright": "© 2026 BTCortex",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "windows/installer.nsi"
      }
    }
  }
}
